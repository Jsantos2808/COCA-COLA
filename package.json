{
  "name": "coca-cola-stock-portal",
  "version": "2.0.0",
  "description": "Portal de gestion de inventarios Coca-Cola",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --runInBand",
    "coverage": "jest --coverage",
    "hooks:install": "node scripts/install-hooks.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/public/**",
      "!src/server.js"
    ]
  }
}
